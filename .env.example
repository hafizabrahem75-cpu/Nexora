# Nexora local development configuration
# Copy this file to .env only in your local environment.
# Never put real secrets in this file or commit a populated .env.

# API server
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Mobile app — public endpoint URLs only; these are bundled into the client.
# Replace example domains when a backend is deployed.
EXPO_PUBLIC_API_URL=https://api.example.com/api
EXPO_PUBLIC_WS_URL=wss://api.example.com/api/ws

# Optional static web build hosting origin (no credentials).
PUBLIC_BASE_URL=https://app.example.com
